{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modular-3d-view",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_BASE_URL": "https://modular-3d-view.lenin19910527.workers.dev",
    "TRIMBLE_REGION": "us"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "231fadaabbfe4ac9aea8c5b6c342273a"
    }
  ],
  "observability": { "enabled": true }
}
