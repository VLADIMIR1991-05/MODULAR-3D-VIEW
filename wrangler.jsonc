{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modular-3d-view",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/latest.json", "/releases/*"]
  },
  "vars": {
    "APP_BASE_URL": "https://modular-3d-view.lenin19910527.workers.dev",
    "MASTER_EMAIL": "desarrollo@modular-3d.com",
    "TRIMBLE_REGION": "us"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "231fadaabbfe4ac9aea8c5b6c342273a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "modular-3d-models"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modular-3d-platform",
      "database_id": "02e16fc0-a2d9-438a-8984-221e714afc6c",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
